{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fvm-tap",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": { "enabled": true },
  "workers_dev": true
}
